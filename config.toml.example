# Squiddish Caching Proxy Configuration

# Bind address for the proxy server
bind_addr = "127.0.0.1:3128"

[cache]
# Memory cache size in bytes (1GB default)
memory_size = 1073741824

# Disk cache size in bytes (100GB default)
disk_size = 107374182400

# Disk cache directory
cache_dir = "./cache"

# Enable compression for cached content
compression = true

# Default TTL for cached entries in seconds (7 days)
ttl_seconds = 604800

[apt]
# Enable APT-specific optimizations
enabled = true

# APT package list TTL in seconds (1 hour)
list_ttl_seconds = 3600

# Optional: Specific repositories to optimize for
repositories = []

[security]
# Maximum request/response body size (10GB for large packages)
max_body_size = 10737418240

# Maximum concurrent connections
max_connections = 1000

# Request timeout in seconds
timeout_seconds = 300

# Only allow HTTPS CONNECT on port 443
strict_https = true

# Allowed hosts (empty = allow all)
# Example: allowed_hosts = ["ubuntu.com", "debian.org"]
allowed_hosts = []

# Blocked hosts
# Example: blocked_hosts = ["malicious.com"]
blocked_hosts = []
